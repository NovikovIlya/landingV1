  function updateContent(slideIndex: number) {
    const slide = slides[slideIndex];
    
    // Update image
    if (featureImage) {
      featureImage.src = slide.image;
      featureImage.alt = slide.title;
    }
    
    // Update content
    if (featureContent) {
      featureContent.innerHTML = `
        <h2 class="text-2xl font-bold mb-6">${slide.title}</h2>
        <ul class="space-y-4 list-disc pl-5">
          ${slide.features.map(feature => `<li>${feature}</li>`).join('')}
        </ul>
      `;
    }
  }

  buttons.forEach((button, index) => {
    button.addEventListener('click', () => {
      // Update button styles
      buttons.forEach(btn => {
        btn.classList.remove('bg-[#3073D7]', 'text-white', 'border-transparent');
        btn.classList.add('hover:bg-gray-100');
      });
      
      button.classList.add('bg-[#3073D7]', 'text-white', 'border-transparent');
      button.classList.remove('hover:bg-gray-100');
      
      // Update content
      updateContent(index);
    });
  });
