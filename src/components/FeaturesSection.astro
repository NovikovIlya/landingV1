<section id="features" class="mx-auto container pt-[13px]">
  <h2 class="w-full text-2xl md:text-[42px] text-black text-center font-bold leading-[140%] mb-[40px] mt-[100px]">
    Реализованные фичи
  </h2>

  <!-- Navigation buttons -->
  <div class="flex flex-wrap gap-2 mb-[38px]" style="font-family: 'PT Sans'">
    {slides.map((slide, index) => (
      <button
        class={`feature-btn border-1 border-solid border-black p-2 text-sm transition-all duration-300 rounded-full h-full flex items-center ${
          index === 0 ? 'bg-[#3073D7] text-white border-transparent' : 'hover:bg-gray-100'
        }`}
        data-slide={slide.id}
        data-index={index}
      >
        {slide.title}
      </button>
    ))}
  </div>

  <!-- Content container -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-gray-50 rounded-lg min-h-[400px]">
    <!-- Left part - image -->
    <div class="flex items-center justify-center bg-gray-100 rounded-lg overflow-hidden">
      <img id="feature-image" src={slides[0].image} alt="Функция" class="w-full h-full object-cover" loading="lazy" />
    </div>

    <!-- Right part - content -->
    <div class="flex flex-col justify-start mt-5" style="font-family: 'PT Sans'">
      <div id="feature-content" class="fade-in">
        <h2 class="text-2xl font-bold mb-6">{slides[0].title}</h2>
        <ul class="space-y-4 list-disc pl-5">
          {slides[0].features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

